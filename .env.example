# === Frontend (Vite) — safe for browser ===
# These are PUBLIC keys. The anon key is designed to be exposed to the browser.
# Security is enforced by Supabase Row Level Security (RLS) policies.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# === Edge Function Secrets (set via Supabase Dashboard, NOT in this file) ===
# These are NEVER exposed to the browser. Set them in:
# Supabase Dashboard → Edge Functions → Secrets
#
# GEMINI_API_KEY=your-gemini-api-key
# OPENROUTER_API_KEY=your-openrouter-api-key
# NVIDIA_API_KEY=your-nvidia-api-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
